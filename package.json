{
    "name": "neuro-commenting-app",
    "version": "1.0.0",
    "description": "Telegram Neuro-Commenting Bot Dashboard",
    "main": "electron/main.js",
    "scripts": {
        "start": "electron .",
        "dev": "npm run dev --prefix dashboard/frontend",
        "build": "electron-builder",
        "pack": "electron-builder --dir"
    },
    "build": {
        "appId": "com.neurocore.commenting",
        "productName": "NEURO.CORE",
        "win": {
            "target": "nsis",
            "icon": "assets/icon.ico"
        },
        "files": [
            "electron/**/*",
            "dashboard/**/*",
            "modules/**/*",
            "utils/**/*",
            "data/**/*",
            "sessions/**/*",
            "*.py",
            "*.envv",
            "requirements.txt"
        ],
        "extraResources": [
            {
                "from": ".",
                "to": "app",
                "filter": [
                    "**/*.py",
                    "requirements.txt",
                    "1.envv"
                ]
            }
        ]
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    },
    "dependencies": {
        "electron-store": "^8.1.0"
    }
}