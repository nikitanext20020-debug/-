# === Конфигурация бота (placeholder-значения) ===
# Скопируйте этот файл и заполните своими ключами. НЕ коммитьте боевые ключи в git!

# Telegram API (https://my.telegram.org/apps) - используется как глобальный fallback
# при импорте .session-файлов. Каждый аккаунт может иметь свой api_id/api_hash в БД.
Api_id=
Api_hash=

# AI provider (RouterAI / Gemini-совместимый OpenAI API)
GEMINI_API_KEY=
GEMINI_MODEL=google/gemini-3-flash-preview
GEMINI_BASE_URL=https://routerai.ru/api/v1

# Опциональный токен для защиты дашборда (Bearer-token).
# Если не указан — дашборд открыт без авторизации (для localhost).
DASHBOARD_TOKEN=

# Опциональный список разрешённых Origin для CORS (через запятую).
# По умолчанию '*'.
DASHBOARD_ORIGIN=*

# Авто-старт воркеров аккаунтов со статусом "active" при запуске сервера (1/0).
AUTOSTART_WORKERS=1

# OpenAI fallback (legacy)
OpenAI_token=
Owner_id=
